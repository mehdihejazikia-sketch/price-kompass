{
  "manifest_version": 3,
  "name": "قیمت‌یاب – افزونه استعلام قیمت",
  "short_name": "قیمت‌یاب",
  "version": "1.4.0",
  "description": "قیمت کالا را مثل یک کاربر در ترب، دیجی‌کالا، ایمالز و هوشمند می‌خواند و به سایت قیمت‌یاب برمی‌گرداند.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://torob.com/*",
    "https://*.torob.com/*",
    "https://www.digikala.com/*",
    "https://digikala.com/*",
    "https://api.digikala.com/*",
    "https://emalls.ir/*",
    "https://*.emalls.ir/*",
    "https://www.hooshmandco.com/*",
    "https://hooshmandco.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://price-kompass.vercel.app/*",
      "http://localhost:3000/*",
      "http://localhost:3100/*"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "قیمت‌یاب"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
