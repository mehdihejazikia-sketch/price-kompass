# Postgres connection (Vercel + Neon integration sets these automatically)
DATABASE_URL=postgres://pk:pk@localhost:5432/pk
# Optional: direct (unpooled) connection used for migrations
# DATABASE_URL_UNPOOLED=

# First admin account, created by `npm run migrate` only if no user exists yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
ADMIN_COMPANY=شرکت من

# Origins allowed to talk to the browser extension (comma separated).
# On Vercel the production domain is added automatically.
# EXTENSION_ALLOWED_ORIGINS=https://price-kompass.vercel.app
